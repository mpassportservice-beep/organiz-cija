# All optional – defaults suit a farm at Priekuļi.
PORT=8787
FARM_NAME=Priekuļi
FARM_LAT=57.315
FARM_LON=25.355
FETCH_INTERVAL_MIN=10
# DB_PATH=./server/data/spray.sqlite

# LVC road weather (data.gov.lv). Set the resource id to skip dataset discovery;
# set an API key if the dataset is only readable to registered users.
# LVC_DATASET=aktualie-celu-meteorologisko-staciju-dati
# LVC_RESOURCE_ID=
# CKAN_API_KEY=
# LVC_TIMEZONE=Europe/Riga
# LVC_MAX_STATIONS=2
# LVC_MAX_KM=40

# LVGMC: empty = nearest station to the farm (Priekuļi, RIPR99PA)
# LVGMC_STATION_ID=

# Contact shown to push services (required by the Web Push spec)
# VAPID_SUBJECT=mailto:you@example.com

# Only if the server sits behind an outbound HTTP proxy (Node >= 22.21):
# NODE_USE_ENV_PROXY=1
